# Источник аналитики/orderflow: публичные потоки Binance Spot. Не менять для текущего сетапа.
SYMBOLS=ETHUSDT,BTCUSDT
PORT=8787
TIMEZONE=Europe/Warsaw

# H1 FVG / цель
MIN_FVG_BPS=4
ZONE_MAX_AGE_HOURS=240
MIN_TARGET_RR=2.5
MIN_TARGET_SCORE=4
TARGET_BUFFER_BPS=3
WALL_MULTIPLIER=3
DEPTH_LEVELS=20

# Orderflow: две фазы — поглощение, затем перехват инициативы
MIN_FLOW_NOTIONAL_USDT=25000
ABSORPTION_RATIO=1.15
INITIATIVE_RATIO=1.15
ABSORPTION_WINDOW_MINUTES=5
CONFIRMATION_WINDOW_MINUTES=3
MAX_ABSORPTION_DRIFT_BPS=10

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GPT необязателен: без ключа используется обычный текст на русском
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Всегда true: реальный счёт не поддерживается этим проектом.
SIGNALS_ONLY=true
DATA_DIR=./data

# Исполнение подтверждённых сигналов: только BingX Demo Trading (VST)
# Сначала оставь false, проверь Telegram и /health. Затем включи true.
BINGX_DEMO_EXECUTION=false
BINGX_API_KEY=
BINGX_API_SECRET=
# Явный объём демо-сделки для каждой пары; позже заменим на расчёт риска от VST-баланса.
BINGX_DEMO_QUANTITIES_JSON={"ETHUSDT":0.01,"BTCUSDT":0.001}
BINGX_RECV_WINDOW=5000
