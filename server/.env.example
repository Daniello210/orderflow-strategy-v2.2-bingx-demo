# Источник аналитики/orderflow: публичные потоки Binance Spot. Не менять для текущего сетапа.
SYMBOLS=ETHUSDT,BTCUSDT,SOLUSDT,XRPUSDT,NEARUSDT,LDOUSDT,WLDUSDT,RENDERUSDT,HYPEUSDT
PORT=8787
TIMEZONE=Europe/Warsaw

# H4 FVG / H1 confirmation / swing target
MIN_FVG_BPS=4
ZONE_MAX_AGE_HOURS=240
MIN_TARGET_RR=5.0
MIN_TARGET_SCORE=4
TARGET_BUFFER_BPS=3
FVG_BOUNDARY_PROXIMITY_BPS=5
FVG_STOP_BUFFER_BPS=8
SWING_MIN_ZONE_WIDTH_BPS=30
SWING_MIN_RISK_BPS=25
SWING_MIN_REWARD_BPS=80
ADAPTIVE_STOP_EXTRA_BPS=24
ADAPTIVE_TARGET_BUFFER_MIN_BPS=1
ADAPTIVE_TARGET_BUFFER_MAX_BPS=15
WALL_MULTIPLIER=3
DEPTH_LEVELS=20

# Подтверждение финального сигнала: цена у границы FVG + перевес orderbook
ORDERBOOK_IMBALANCE_RATIO=1.15
MIN_FLOW_NOTIONAL_USDT=25000
ABSORPTION_RATIO=1.15
INITIATIVE_RATIO=1.15
ABSORPTION_WINDOW_MINUTES=5
CONFIRMATION_WINDOW_MINUTES=3
MAX_ABSORPTION_DRIFT_BPS=10

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GPT необязателен: без ключа используется обычный текст на русском
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Всегда true: реальный счёт не поддерживается этим проектом.
SIGNALS_ONLY=true
DATA_DIR=./data

# Исполнение подтверждённых сигналов: только BingX Demo Trading (VST)
# Сначала оставь false, проверь Telegram и /health. Затем включи true.
BINGX_DEMO_EXECUTION=false
BINGX_API_KEY=
BINGX_API_SECRET=
# Явный объём демо-сделки для каждой пары; позже заменим на расчёт риска от VST-баланса.
BINGX_DEMO_QUANTITIES_JSON={"ETHUSDT":0.01,"BTCUSDT":0.001,"SOLUSDT":0.1,"XRPUSDT":10,"HYPEUSDT":1,"NEARUSDT":1,"LDOUSDT":5,"WLDUSDT":5,"RENDERUSDT":1}
BINGX_RECV_WINDOW=5000
BINGX_STOP_AFTER_AUTH_ERROR=true

# Optional. If set, admin write endpoints require X-Admin-Token.
ADMIN_TOKEN=
